// SPDX-License-Identifier: Apache-2.0
//
// MediaTek boot control HAL, from LineageOS android_hardware_mediatek
// (lineage-23.2, aidl/boot @ 680a9b6); not yet in lineage-22.2.
//

package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "android.hardware.boot-service_mediatek_common",
    relative_install_path: "hw",
    defaults: ["libboot_control_defaults"],
    srcs: [
        "main.cpp",
        "BootControl.cpp",
        "MtkBootRegionControl.cpp",
        "emmc-bootpart.cpp",
        "ufs-bsg.cpp",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.mediatek",
    defaults: ["android.hardware.boot-service_mediatek_common"],
    init_rc: ["android.hardware.boot-service.mediatek.rc"],
    vendor: true,

    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
        "libbase",
        "libboot_control",
    ],
    header_libs: [
        "device_kernel_headers"
    ],

    vintf_fragments: ["android.hardware.boot-service.mediatek.xml"],
}

cc_binary {
    name: "android.hardware.boot-service.mediatek_recovery",
    defaults: ["android.hardware.boot-service_mediatek_common"],
    init_rc: ["android.hardware.boot-service.mediatek_recovery.rc"],
    recovery: true,

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
    ],
    static_libs: [
        "libboot_control",
    ],
    header_libs: [
        "device_kernel_headers"
    ],
}
