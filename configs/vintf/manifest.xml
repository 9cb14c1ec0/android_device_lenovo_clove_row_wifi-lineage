<!--
    Device VINTF manifest for clove_row_wifi, taken VERBATIM from the stock
    Lenovo Android 15 vendor partition (pulled live over adb from
    /dev/block/mapper/vendor_a, slot A).

    NOTE: target-level is 6 (FCM 6 / Android 12), not the Android 15 default.
    MediaTek froze the vendor interface at FCM 6 on this platform. Because this
    port KEEPS the stock vendor partition, the framework must remain compatible
    with FCM 6 -- do not "modernise" this value.

    38 manifest fragments from /vendor/etc/vintf/manifest/ are kept alongside
    in manifest_fragments/ for reference; they ship inside the stock vendor
    image and are NOT rebuilt by this tree.
-->
<!--
    Input:
        device/mediatek/vendor/common/project_manifest/manifest_isphal.xml
        device/mediatek/vendor/common/project_manifest/manifest_cameraprovider.xml
        device/mediatek/vendor/common/project_manifest/manifest_postproc.xml
        device/mediatek/vendor/common/project_manifest/manifest_audio.xml
        device/mediatek/vendor/common/project_manifest/manifest_em.xml
        device/mediatek/vendor/common/project_manifest/manifest_km41.xml
        device/mediatek/vendor/common/project_manifest/manifest_log.xml
        device/mediatek/vendor/common/project_manifest/manifest_aee.xml
        device/mediatek/vendor/common/project_manifest/manifest_boot.xml
        device/mediatek/vendor/common/project_manifest/manifest_pq.xml
        device/mediatek/vendor/common/project_manifest/manifest_mmservice.xml
        device/mediatek/vendor/common/project_manifest/manifest_mmagent.xml
        device/mediatek/common/project_manifest/manifest_dmc.xml
        device/mediatek/common/project_manifest/manifest_apmonitor.xml
        device/mediatek/vendor/common/project_manifest/manifest_composer.xml
        device/mediatek/vendor/common/manifest.xml
        device/mediatek/vendor/common/manifest_target_level_s.xml
-->
