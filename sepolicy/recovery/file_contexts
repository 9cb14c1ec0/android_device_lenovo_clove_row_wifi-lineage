# Only reaches the RECOVERY ramdisk policy: this port ships the stock vendor
# image, whose own policy labels these nodes the same way on normal boots.
/dev/block/by-name/misc                           u:object_r:misc_block_device:s0
/dev/block/platform/11230000\.mmc/by-name/misc    u:object_r:misc_block_device:s0
/dev/block/mmcblk0                                u:object_r:bootdevice_block_device:s0
